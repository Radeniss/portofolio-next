// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imageUrl    String?
  status      String
  technologies String[]
  stars       Int
  forks       Int
  githubUrl   String?
  liveUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PortfolioItem {
  id        Int      @id @default(autoincrement())
  title     String
  author    String
  date      DateTime
  icon      String
  images    String[]
  desc      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Certificate {
  id           Int      @id @default(autoincrement())
  title        String
  issuer       String
  date         DateTime
  validUntil   String?
  credentialId String
  image        String?
  description  String
  skills       String[]
  verifyUrl    String?
  downloadUrl  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
